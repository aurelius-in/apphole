# AppHole local/production environment
# Copy to .env.local and fill in values. Never commit secrets.

NEXT_PUBLIC_SITE_URL=http://localhost:3333
AUTH_SECRET=

# Optional: set APPHOLE_AI_PLUGS=1 to rewrite plug wording. Findings still come from evidence.
APPHOLE_AI_PLUGS=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Stripe (test mode first). Leave blank to run Free scans without checkout.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Durable store. Local default is data/store.json.
# Production on Vercel cannot use that file (serverless /tmp is per-instance).
# Preferred order: DATABASE_URL (Postgres), KV_REST_API_URL + KV_REST_API_TOKEN
# (Upstash / Vercel KV), or BLOB_READ_WRITE_TOKEN + BLOB_STORE_ID (Vercel Blob).
DATABASE_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Plug-quote leads live in the same store (file locally, Blob/Redis/Postgres in production).
# On Vercel also set notify so a lead is emailed even if you are not grepping the store.
# Leads are quote requests, not Stripe charges.
PLUG_LEAD_NOTIFY_EMAIL=
PLUG_LEAD_FROM_EMAIL=AppHole <hello@apphole.pro>
RESEND_API_KEY=
PLUG_LEAD_WEBHOOK_URL=

# Set to 1 to attempt Playwright screenshots/console capture when Chromium is installed.
APPHOLE_PLAYWRIGHT=0
