# AppHole local/production environment
# Copy to .env.local and fill in values. Never commit secrets.

NEXT_PUBLIC_SITE_URL=http://localhost:3333
AUTH_SECRET=

# Optional: set APPHOLE_AI_PLUGS=1 to rewrite plug wording. Findings still come from evidence.
APPHOLE_AI_PLUGS=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Stripe (test mode first). Leave blank to run Free scans without checkout.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Optional Postgres later. Default store is a local JSON file (or /tmp on Vercel).
DATABASE_URL=

# Set to 1 to attempt Playwright screenshots/console capture when Chromium is installed.
APPHOLE_PLAYWRIGHT=0
